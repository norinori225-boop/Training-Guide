# このファイルをコピーして .env.local を作り、Supabase の値を入れてください。
#   cp .env.local.example .env.local
# .env.local は .gitignore 済みなので Git には入りません。

# Supabase の Project Settings → API から取得
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ⚠️ service_role キーは RLS をすり抜ける管理者キー。
# ローカルのシードスクリプト専用で、アプリのリクエスト処理では絶対に使わない。
# Vercel などのホスティング側にも設定しないこと。
# ※ ここに anon キーを入れないこと（別物です）。
# マイグレーションは SQL Editor から適用できるため、空のままで問題ありません。
SUPABASE_SERVICE_ROLE_KEY=
